# Local AI is the default: no API key or provider quota.
# run.py and the CLI load .env automatically. Never commit .env.
AI_PROVIDER=ollama
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional hosted alternative: AI_PROVIDER=groq, with GROQ_API_KEY set.
OLLAMA_MODEL=qwen2.5:3b
# Leave OLLAMA_BASE_URL unset for automatic project-local Ollama setup.
