# Shared Gemini AI is ready for public downloads. A personal Google key is optional.
# run.py and the CLI load .env automatically. Never commit .env.
AI_PROVIDER=shared
# Optional separate reviewer model for personal Gemini mode. Leave blank to use GEMINI_MODEL.
GEMINI_CRITIC_MODEL=
# For personal API access, set AI_PROVIDER=gemini and fill this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional hosted alternative: AI_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional local alternative: python run.py --local-ai.
OLLAMA_MODEL=qwen2.5:3b
# Leave OLLAMA_BASE_URL unset for automatic project-local Ollama setup.
